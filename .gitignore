node_modules/

# Build output. apps/desktop/out is regenerated by `npm run desktop`; it was
# tracked for a while, which made every build show up as a diff with a fresh
# content-hashed filename for each renderer asset.
dist/
out/
*.tsbuildinfo

# Bundled mpv binaries, fetched by scripts/fetch-mpv.mjs at build time. Over a
# hundred megabytes per platform, and reproducible, so they are not committed.
apps/desktop/resources/mpv/*/*
!apps/desktop/resources/mpv/*/.gitkeep

# Built installers.
release/

# Generated test films and scratch fixtures. Regenerated on first run; some are
# hundreds of megabytes.
.fixtures/

# Local identity and any real secret. turnserver.conf in infra/ is a template
# with a placeholder secret; a filled-in copy must never be committed.
*.local.conf
.env
.env.*
