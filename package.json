{
  "name": "cocine",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/desktop/tsconfig.node.json --noEmit && tsc -p apps/desktop/tsconfig.web.json --noEmit",
    "phase0": "tsx packages/player/scripts/verify.ts",
    "phase1": "tsx apps/server/scripts/drift-test.ts",
    "server": "tsx apps/server/scripts/serve.ts",
    "desktop": "npm run build --workspace @cocine/desktop && electron apps/desktop",
    "desktop:dev": "npm run dev --workspace @cocine/desktop",
    "phase1:heavy": "tsx apps/server/scripts/drift-test.ts --peers=5 --film=300 --duration=150 --events=10 --latency=40 --jitter=15 --skew=37000 --res=1080",
    "test:app": "vitest run --config vitest.e2e.config.ts",
    "phase4": "tsx apps/server/scripts/transfer-test.ts",
    "phase7": "tsx apps/server/scripts/relay-cost.ts",
    "nat-check": "tsx apps/server/scripts/nat-check.ts",
    "dist:linux": "npm run dist:linux --workspace @cocine/desktop",
    "dist:win": "npm run dist:win --workspace @cocine/desktop",
    "fetch-mpv": "node scripts/fetch-mpv.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "electron": "44.2.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "x11": "^4.1.0"
  }
}
